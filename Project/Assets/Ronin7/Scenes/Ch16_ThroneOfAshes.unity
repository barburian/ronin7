--- !u!114 &888565376
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 888565375}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Soren
    text: No. You hear me, whatever you are up on that throne. No. You built me to
      carry the dead. You broke open a conscience so it would feel every single thing
      it was made to do and then you scaled that into a galaxy, and you think a man
      you built to carry the dead is going to be worn down by reliving one death.
      I have carried worse than this. I have carried a whole world I burned with
      these hands and I got up the next morning anyway. I will choose different until
      your trap runs out of room. Spare him. Walk past him. Put the blade down. Reach
      with the other hand. There are more ways to live through a moment than your
      machine can count, because it only knows the one ending, and I am made of every
      other one.
    seconds: 49
    clip: {fileID: 0}
  textMesh: {fileID: 689622628}
  panelRoot: {fileID: 999826092}
  audioSource: {fileID: 888565377}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
