  - component: {fileID: 360354907}
  - component: {fileID: 360354906}
  - component: {fileID: 360354905}
  m_Layer: 0
  m_Name: Dialogue_Beat3_Recruit
  m_TagString: Untagged
  m_Icon: {fileID: 0}
