--- !u!114 &1379816874
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1379816873}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Ronin-7
    text: It's done. No last word, no fight left to give. They took everything out
      of you but the order, and now even that's gone. Rest, Wraith. You came before
      me and you never once got to.
    seconds: 9
    clip: {fileID: 0}
  - speaker: Echo
    text: His shadow's free, Cipher. The leash died with him and the thing they wired
      behind his eyes just came loose. It's reaching for me, the way Coral's knew
      mine in the reliquary. It wants a home, and we're the only door open in this
      whole drowned hole. Hold still. Let it come. This is going to be fast.
    seconds: 15
    clip: {fileID: 0}
  textMesh: {fileID: 1894639425}
  panelRoot: {fileID: 873338754}
  audioSource: {fileID: 1379816875}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
