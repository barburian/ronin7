  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Ronin-7
    text: I do for her what I did for him. The only door I've got. I'm sorry I came
      too late to give you anything better. You held up everyone you ever lost until
      there was nothing left of you that wasn't holding. Put it down now. Whoever
      you were before they racked you, whatever name was yours, you go out as that,
      not as a node. I free you the only way that's left. Rest.
    seconds: 18
    clip: {fileID: 8300000, guid: d607866fbf73bbd4d8db7df7ea854d8b, type: 3}
