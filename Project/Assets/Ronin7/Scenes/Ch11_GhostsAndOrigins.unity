--- !u!114 &51935428
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 51935427}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Echo
    text: Feel that. The haze just let go of you. The dream can't hold you now, Cipher.
      That's the first half of what he gave you, a mind it can't drown, a fear it
      can't pour into you, a narcosis that slides right off. Unbroken. And the second
      half. He spent forever surviving the one blow that should have ended him, over
      and over, because the order wouldn't let him fall. So now, once, when something
      lands a blow that should put you in the dark for good, you don't go. You take
      it, and you keep standing, the way he kept standing. Once. Spend it well. It's
      the only time the first of them ever got to give instead of keep.
    seconds: 26
    clip: {fileID: 8300000, guid: 68657a6dfd75d534eafefe1e3ef5f33b, type: 3}
  textMesh: {fileID: 1299807582}
  panelRoot: {fileID: 1733059173}
  audioSource: {fileID: 51935429}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
