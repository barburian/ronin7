--- !u!114 &22135042
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 22135041}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Trooper 1
    text: Salvage registry. We're conducting a sweep. Stand clear of the hatch.
    seconds: 4
    clip: {fileID: 8300000, guid: 00794b03cf698e44b8b0addb28cfe59d, type: 3}
  - speaker: Kessler
    text: Sweep for what? I'm licensed in this field. Manifest's logged, tariffs
      are clean. You can pull it from here.
    seconds: 7
    clip: {fileID: 8300000, guid: b7b95fc09acb7504483045bebbf1b3f2, type: 3}
  - speaker: Squad Leader (V.O.)
    text: Manifest doesn't cover what we're looking for. Step back.
    seconds: 3.5
    clip: {fileID: 8300000, guid: 65367e1485069ec47adf0055d078c75d, type: 3}
  - speaker: Kessler
    text: I've got a dead reactor and a hold full of other men's garbage. There's
      nothing on this rig worth two troopers and a clamp.
    seconds: 9
    clip: {fileID: 8300000, guid: b48bedb135facc44fba08dd5b594cf23, type: 3}
  - speaker: Trooper 1
    text: Then it won't take long.
    seconds: 2
    clip: {fileID: 8300000, guid: f195524ff33d6d84bbcf3994fca8431e, type: 3}
  - speaker: Kessler
    text: Hey, listen, there's medical gear back there, half of it live, you go poking
      it...
    seconds: 5.5
    clip: {fileID: 8300000, guid: 5cb69c1ff350684428e039cb5cffa7dd, type: 3}
  - speaker: Trooper 2
    text: Stay. There.
    seconds: 1.5
    clip: {fileID: 8300000, guid: 92f36d11efb211341bd3525d6e9da941, type: 3}
  - speaker: Trooper 1
    text: Command. I've got a face-match flagged here.
    seconds: 3
    clip: {fileID: 8300000, guid: 5cb1630c151b1de4ebf0ed75cc31e8fc, type: 3}
  - speaker: Squad Leader (V.O.)
    text: Match to what.
    seconds: 1.5
    clip: {fileID: 8300000, guid: 70b78f4f1c954d04998dde35825da903, type: 3}
  - speaker: Trooper 1
    text: Flag says decedent. Repeat. The file says this man is deceased. Closed.
      He's standing in front of me.
    seconds: 7.5
    clip: {fileID: 8300000, guid: 4d5409bf203960f4b84e9ec372bc9b9d, type: 3}
  - speaker: Comm (V.O.)
    text: Hold position. Confirm the face. Stream it. Now, to me. Direct.
    seconds: 5
    clip: {fileID: 8300000, guid: 465a3fbeecab2c64f9f386c79b9e4c33, type: 3}
  - speaker: Trooper 1
    text: ...Confirming. Stream is live, sir.
    seconds: 2.5
    clip: {fileID: 8300000, guid: f8ba89dfca0202940a34fb8df97a3193, type: 3}
  - speaker: Comm (V.O.)
    text: Confirmed. Terminate. Recover the remains intact.
    seconds: 3
    clip: {fileID: 8300000, guid: 2c37b2e2b9deea64c890ecb7899f68ae, type: 3}
  textMesh: {fileID: 431819975}
  panelRoot: {fileID: 1157661377}
  audioSource: {fileID: 22135043}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
