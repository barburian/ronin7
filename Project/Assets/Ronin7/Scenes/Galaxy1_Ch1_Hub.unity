--- !u!114 &190843716
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 190843715}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Kessler
    text: ...They mobilized a sweep for a dead man.
    seconds: 3
    clip: {fileID: 8300000, guid: 58861aab306cc3142865c9630fd02f73, type: 3}
  - speaker: Ronin-7
    text: Not a sweep. They were looking for me.
    seconds: 3
    clip: {fileID: 8300000, guid: 2a14825a259895d4f9a3546ba63c54bc, type: 3}
  - speaker: Kessler
    text: The file said deceased. I heard it. They've got you written down closed
      and buried, and they still sent armed men aboard the second your face turned
      up. That's not how you treat a corpse. That's how you treat a mistake you thought
      you'd already cleaned up.
    seconds: 18
    clip: {fileID: 8300000, guid: df1f7665992756c45905da05ba947728, type: 3}
  - speaker: Ronin-7
    text: The box didn't hold.
    seconds: 2
    clip: {fileID: 8300000, guid: 3fc7c77c4b7a31a4ba8200493acd1a64, type: 3}
  - speaker: Ronin-7
    text: They know now.
    seconds: 1.5
    clip: {fileID: 8300000, guid: 6c2c8ee6ab3ae434283ee622d27df099, type: 3}
  - speaker: Kessler
    text: Yeah. They surely do.
    seconds: 2
    clip: {fileID: 8300000, guid: 347ee6fc72ce50740b9d08de2a7be981, type: 3}
  - speaker: Kessler
    text: Come on. This conversation's about to get worse, and I'd rather have it
      sitting down.
    seconds: 5.5
    clip: {fileID: 8300000, guid: 2c82a09770755804ca7496730d9f6e41, type: 3}
  textMesh: {fileID: 53837098}
  panelRoot: {fileID: 401983394}
  audioSource: {fileID: 190843717}
