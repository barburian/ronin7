--- !u!114 &2001410526
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2001410525}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Kessler
    text: There it is.
    seconds: 1
    clip: {fileID: 8300000, guid: 8b1b03cdad1efb14da1011aa63a8b779, type: 3}
  - speaker: Kessler
    text: Come on. Stay this time.
    seconds: 2
    clip: {fileID: 8300000, guid: cade9757dc484264a83916eca8910447, type: 3}
  - speaker: Ronin-7
    text: Where am I.
    seconds: 1.5
    clip: {fileID: 8300000, guid: b7c315d83f0353e4a9243381b1144699, type: 3}
  - speaker: Kessler
    text: You're on my ship.
    seconds: 1.5
    clip: {fileID: 8300000, guid: 8854683369b9a7b42a61d727f4f30b07, type: 3}
  - speaker: Ronin-7
    text: That's not an answer.
    seconds: 1.5
    clip: {fileID: 8300000, guid: 1d17576390553b149b9313d26c2b5316, type: 3}
  - speaker: Kessler
    text: It's the only one I've got that's true.
    seconds: 3
    clip: {fileID: 8300000, guid: 84373d22fc0d9964e8392162a7fc22fa, type: 3}
  - speaker: Kessler
    text: You can crush my windpipe. You're built for it, I can feel that much. But
      you already did the hard part.
    seconds: 8.5
    clip: {fileID: 8300000, guid: 95a07b7f3c41c33468d7440301d93670, type: 3}
  - speaker: Ronin-7
    text: What part.
    seconds: 1
    clip: {fileID: 8300000, guid: 5b9e0886347330f4283183b385560d90, type: 3}
  - speaker: Kessler
    text: You didn't kill me. Last time we met, you haven't done that either.
    seconds: 5.5
    clip: {fileID: 8300000, guid: 821c812103f888b4d9875c45e5b637cc, type: 3}
  - speaker: Ronin-7
    text: I don't know you.
    seconds: 1.5
    clip: {fileID: 8300000, guid: 9dafa1d7266cde8448bef2466d07ba8a, type: 3}
  - speaker: Kessler
    text: I know. They took that part out. They're good at it.
    seconds: 4.5
    clip: {fileID: 8300000, guid: e61f9bb93e491e749b92dda71b1ee719, type: 3}
  textMesh: {fileID: 1046038510}
  panelRoot: {fileID: 1378700120}
  audioSource: {fileID: 2001410527}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
