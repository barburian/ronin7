--- !u!114 &1582083570
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1582083568}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Kessler
    text: Word travels faster than we do. Kerrax yielded to you -- the Overseer's
      hunt died with his pride, not a blade.
    seconds: 4.5
    clip: {fileID: 0}
  - speaker: Kessler
    text: Mera Voss watched you spare him. She's crewing with us now. That's two
      mercies paying rent on this ship.
    seconds: 4.5
    clip: {fileID: 0}
  - speaker: Kessler
    text: Don't let it go to your head, Cipher. Mercy's a debt too -- just one they
      can't collect on you.
    seconds: 4.5
    clip: {fileID: 0}
  textMesh: {fileID: 1696327675}
  panelRoot: {fileID: 0}
  audioSource: {fileID: 0}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: 0}
