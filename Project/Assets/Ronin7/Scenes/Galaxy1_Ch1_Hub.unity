  m_IsActive: 1
--- !u!114 &1276073503
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1276073502}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Ronin-7
    text: My hands knew what to do. I didn't tell them.
    seconds: 4.5
    clip: {fileID: 8300000, guid: 5c0f15611961c0144be61e2e4e2c70af, type: 3}
  - speaker: Kessler
    text: Yeah. I've watched them work for three weeks. They don't ask you much.
    seconds: 5.5
    clip: {fileID: 8300000, guid: 3ddb1c6421cad714b96ad78577a25690, type: 3}
  - speaker: Ronin-7
    text: This.
    seconds: 1
    clip: {fileID: 8300000, guid: 57cca94a9caa5764fb29ea22615638a9, type: 3}
  - speaker: Kessler
    text: That was there when I found you. Not my work. Somebody closed that up clean
      and then opened it again. I don't know which order.
    seconds: 10
    clip: {fileID: 8300000, guid: 02ebd756e09d94b4d987ace6422a8c90, type: 3}
  - speaker: Kessler
    text: That came out of the box with you. I cleaned the blood off it. Figured
      it was yours.
    seconds: 7
    clip: {fileID: 8300000, guid: 282854f95ca8b394bbf7039200bf889f, type: 3}
  - speaker: Ronin-7
    text: I don't remember this. But my hands do.
    seconds: 3.5
    clip: {fileID: 8300000, guid: ba69a873c740230409ffbd08ecdde686, type: 3}
  - speaker: Kessler
    text: That's more than you've given me in three weeks. You want to put it down,
      or you want to keep holding the one thing in here that feels like yours?
    seconds: 11
    clip: {fileID: 8300000, guid: 639b55bdcc2494a449442571daa33b93, type: 3}
  - speaker: Ronin-7
    text: What do I call you.
    seconds: 2
    clip: {fileID: 8300000, guid: 39acc3896a5da3b4393e833fc5d58da0, type: 3}
  - speaker: Kessler
    text: Kessler. And before you ask, no. From what I can tell you were Dominion
      property and they have thrown you to garbage.
    seconds: 9
    clip: {fileID: 8300000, guid: 0bc1201909a04bf4ca14df6007e3c4ff, type: 3}
  - speaker: Ronin-7
    text: Then start with where I am. Slowly.
    seconds: 3
    clip: {fileID: 8300000, guid: cb4b3bd0a148c40488fde31f569dc016, type: 3}
  - speaker: Kessler
    text: Now that I can do.
    seconds: 2
    clip: {fileID: 8300000, guid: 3b6122bf763d19f478dcadc42904ec48, type: 3}
  - speaker: Kessler
    text: Come on. Walk it off before you fall down and I have to start over.
    seconds: 5.5
    clip: {fileID: 8300000, guid: 447972145e8896b4aa5ba9509d8e7d18, type: 3}
  textMesh: {fileID: 1615855090}
  panelRoot: {fileID: 1007667924}
  audioSource: {fileID: 1276073504}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: 0}
