  - component: {fileID: 2136307184}
  - component: {fileID: 2136307183}
  - component: {fileID: 2136307182}
  m_Layer: 0
  m_Name: Dialogue_Beat4_Ultimatum
  m_TagString: Untagged
  m_Icon: {fileID: 0}
