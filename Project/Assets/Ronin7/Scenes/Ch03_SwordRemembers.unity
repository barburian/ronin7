  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &426593935
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 426593934}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Kessler
    text: Easy. Easy. You're on the ship. You came back.
    seconds: 4
    clip: {fileID: 8300000, guid: 3db506ec88dfe1845ab0911a17b4ffec, type: 3}
  - speaker: Iris
    text: You were gone four minutes and your eyes were moving the whole time. Reading
      something. What did it show you?
    seconds: 8
    clip: {fileID: 8300000, guid: 1a8744d169bcf6e4bba693411e35db39, type: 3}
  - speaker: Ronin-7
    text: Before I tell them anything. You showed me all of that, and I still don't
      have a thing to call you. What's your name?
    seconds: 8
    clip: {fileID: 8300000, guid: ca53a94c614dc7042881f2a8f4fd4308, type: 3}
  - speaker: Shadow
    text: I don't have one. They don't name the shadows. We're the thing behind your
      eyes, that's all. Shadow is the only word anyone ever put on me, and they put
      it on a dozen others before you. It was never a name. Just the word they stamped
      on the leash.
    seconds: 15
    clip: {fileID: 8300000, guid: 8435c6f3e6cd98f4f8190a605ce94b14, type: 3}
  - speaker: Ronin-7
    text: You're not just a shadow. You're the one piece of me they couldn't scrub.
      An echo of who I was.
    seconds: 12
    clip: {fileID: 8300000, guid: acd4f8c7b164509429a3117ab74c522d, type: 3}
  - speaker: Ronin-7
    text: Echo. I'm calling you Echo from now on.
    seconds: 4
    clip: {fileID: 8300000, guid: 89e6ae33922173a46b008bd53b3c3524, type: 3}
  - speaker: Echo
    text: ...Echo. Yeah. I can wear that one. First thing anybody's handed me instead
      of stamping on me. Don't make it weird.
    seconds: 8
    clip: {fileID: 8300000, guid: 7fbdee3d40482934b881c0c07a55ae71, type: 3}
  textMesh: {fileID: 1687590111}
  panelRoot: {fileID: 770237453}
  audioSource: {fileID: 426593936}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
