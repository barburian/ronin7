  m_IsActive: 1
--- !u!114 &1375159778
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1375159777}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Resh
    text: We came off that rock with a freed tech, a stowaway, and a vault's worth
      of dead men's files. Generous haul. What I don't have is a heading.
    seconds: 10
    clip: {fileID: 8300000, guid: 145614b934cf46547ab23495d58dff5e, type: 3}
  - speaker: Iris
    text: I might have one. I've been reading the files since we burned out of orbit.
      Your switch fired and failed, and yours is the only one on record that did.
      I still can't tell you why. But you are not the only designation in here.
    seconds: 14
    clip: {fileID: 8300000, guid: 95b7184b90ed94246a895b537fdadc92, type: 3}
  - speaker: Kessler
    text: Meaning what.
    seconds: 1
    clip: {fileID: 8300000, guid: 6564d7f7e9863a4449de467a0badf727, type: 3}
  - speaker: Iris
    text: Meaning if one leash slipped, others can. Somewhere out there are operatives
      still wearing theirs, not knowing it can break.
    seconds: 9
    clip: {fileID: 8300000, guid: ad79095770e3685428d69a2784ef11fa, type: 3}
  - speaker: Resh
    text: So we go find them. That's a heading I can work with. Beats bailing one
      kid out of the dark at a time.
    seconds: 8
    clip: {fileID: 8300000, guid: 744882850df4bb545905dd7618c1fff0, type: 3}
  - speaker: Kessler
    text: After everyone sleeps. The ship's been running on his nerves and my coffee
      for a day. Whatever we go after, we go after it rested.
    seconds: 10
    clip: {fileID: 8300000, guid: 35ccb96da8ba4cb4d8f73c8183dd95da, type: 3}
  textMesh: {fileID: 1035755990}
  panelRoot: {fileID: 359426698}
  audioSource: {fileID: 1375159779}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
