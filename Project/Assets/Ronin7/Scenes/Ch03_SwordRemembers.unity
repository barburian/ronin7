  m_IsActive: 1
--- !u!114 &534634529
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 534634528}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Shadow
    text: That's you. Before they wiped it out of you. The last clean hour you had,
      on a world called Kethel-7. I rode every second of it. Walk it with me.
    seconds: 11
    clip: {fileID: 8300000, guid: cbc0207aa91b0fc40acfd5e15b0c5670, type: 3}
  - speaker: Ronin-7
    text: That's my face.
    seconds: 1.5
    clip: {fileID: 8300000, guid: bea0c84a18abd2340a4b0b85280ddd80, type: 3}
  - speaker: Shadow
    text: It's the first time I ever saw one of you stop. It was you. Don't look
      away from this part. Looking away is the one thing they trained into all of
      you that actually took.
    seconds: 11
    clip: {fileID: 8300000, guid: ad6aeda11c5e8a942a9b531e0651d706, type: 3}
  - speaker: Khall
    text: Cipher. The order is live. Complete the sweep.
    seconds: 4
    clip: {fileID: 8300000, guid: 7b9cd54129b8a5f4c9c812fb43dff893, type: 3}
  - speaker: Ronin-7
    text: He's not armed. There are children behind that door.
    seconds: 4
    clip: {fileID: 8300000, guid: 3fa9e18777cd294479c78ea46eee2c68, type: 3}
  - speaker: Khall
    text: The order does not have a door in it.
    seconds: 3.5
    clip: {fileID: 8300000, guid: e78d66996fc0e3b43af5e40dcd121e6e, type: 3}
  - speaker: Khall
    text: Complete the sweep. That's twice I've said it.
    seconds: 4
    clip: {fileID: 8300000, guid: 1d420d9cf3befb14ba61b68d5f57e0cf, type: 3}
  - speaker: Ronin-7
    text: No.
    seconds: 1
    clip: {fileID: 8300000, guid: c24afd39155ccd043844b45571f82c75, type: 3}
  textMesh: {fileID: 1311904436}
  panelRoot: {fileID: 1513464873}
  audioSource: {fileID: 534634530}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
