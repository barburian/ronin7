  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Echo
    text: It's down, and notice what didn't happen. No shadow came off it. Nothing
      to free, nothing to carry. It was never a person, Cipher, just a thing they
      built to make people stop being people. Fitting, in a place like this. The
      door's open. She's right through it. The hand that made the both of us, ten
      feet away. Whatever you've been bracing for since the briefing, brace now.
      And remember what I said. I'm right here.
    seconds: 30
    clip: {fileID: 8300000, guid: ac8b401b48260754f80bca6c793e87c5, type: 3}
  textMesh: {fileID: 1773680480}
  panelRoot: {fileID: 427411345}
