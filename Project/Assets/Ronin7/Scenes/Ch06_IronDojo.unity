  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Echo
    text: That's her window. No light, no guard, cracked open from the inside a while
      now. Last reach, Cipher. After this it's just you, the cold, and the woman
      in the dark.
    seconds: 12
    clip: {fileID: 8300000, guid: 10f3cb5a59b46684c88a71caba6b6667, type: 3}
  textMesh: {fileID: 1217034214}
  panelRoot: {fileID: 1820160840}
