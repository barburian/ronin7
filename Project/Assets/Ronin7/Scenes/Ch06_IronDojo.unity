--- !u!114 &33250676
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 33250675}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Morrigan
    text: Cipher. You came up the cliff. Good. Sit, don't sit, I don't care. We have
      a small window and a large mountain.
    seconds: 10
    clip: {fileID: 8300000, guid: 1f662e1f6086f0247820cf34d2cdce61, type: 3}
  - speaker: Ronin-7
    text: Resh sent me. He says you've been pulling children out of here for years.
    seconds: 5
    clip: {fileID: 8300000, guid: 729df68aa8036424c84833bf2cc838df, type: 3}
  - speaker: Morrigan
    text: Nine years, one child out the bottom whenever I could stomach the math.
      Don't call that a clean conscience. It's just what I pay myself to get out
      of bed. I can't empty this place alone. You can.
    seconds: 16
    clip: {fileID: 8300000, guid: 5d69ac31d84ba1a4c93af37ff80405a6, type: 3}
  - speaker: Ronin-7
    text: Tell me where it breaks.
    seconds: 2
    clip: {fileID: 8300000, guid: db351ad3d39ccc540b01b23feee2d481, type: 3}
  textMesh: {fileID: 92547841}
  panelRoot: {fileID: 908741990}
  audioSource: {fileID: 33250677}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
