  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Ronin-7
    text: You're not going with them.
    seconds: 2
    clip: {fileID: 8300000, guid: 298dea5bd343eef4eac7367fe7ac1f66, type: 3}
  - speaker: Morrigan
    text: They get to walk away from this. I don't, not yet. They go down the mountain.
      I've got to go further up. Because your leash didn't slip on its own, and I've
      spent nine years close enough to the work to know it.
    seconds: 16
    clip: {fileID: 8300000, guid: af57351a64f7e2a41be5c3d0f732d55f, type: 3}
  textMesh: {fileID: 1610521616}
  panelRoot: {fileID: 2028519907}
