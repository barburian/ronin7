--- !u!114 &1985378262
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1985378261}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Broker
    text: Glass stays down. You talk to the grille or you talk to nobody. What do
      you want.
    seconds: 6
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: Operative records. A termination file. The designation is mine.
    seconds: 4.5
    clip: {fileID: 0}
  - speaker: Broker
    text: No. No, no. You're the kind of question that gets a man's stall burned
      with him inside it.
    seconds: 7
    clip: {fileID: 0}
  - speaker: Broker
    text: I don't have it. I never had it. Move on before somebody sees you standing
      here.
    seconds: 6
    clip: {fileID: 0}
  - speaker: Kessler
    text: We can pay.
    seconds: 1.5
    clip: {fileID: 0}
  - speaker: Broker
    text: Money's not what gets you in. That vault wants trust, and I've got none
      to spend on you.
    seconds: 7
    clip: {fileID: 0}
  - speaker: Kessler
    text: He's a wall. So we go around him.
    seconds: 3
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: Around how.
    seconds: 1.5
    clip: {fileID: 0}
  - speaker: Kessler
    text: Resh already gave us the door. His routes run under this stall. Let's move.
    seconds: 5
    clip: {fileID: 0}
  textMesh: {fileID: 2093468446}
  panelRoot: {fileID: 246336476}
  audioSource: {fileID: 1985378263}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
