--- !u!114 &390531683
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 390531682}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Broker
    text: Glass stays down. You talk to the grille or you talk to nobody. What do
      you want.
    seconds: 6
    clip: {fileID: 8300000, guid: f74bf0420bba03e46a779a98dd11db40, type: 3}
  - speaker: Ronin-7
    text: Operative records. A termination file. The designation is mine.
    seconds: 4.5
    clip: {fileID: 8300000, guid: d93909c6834b84341be0e98ff5325b62, type: 3}
  - speaker: Broker
    text: No. No, no. You're the kind of question that gets a man's stall burned
      with him inside it.
    seconds: 7
    clip: {fileID: 8300000, guid: 05f1508ad823c8743a65d3276c1f5e9d, type: 3}
  - speaker: Broker
    text: I don't have it. I never had it. Move on before somebody sees you standing
      here.
    seconds: 6
    clip: {fileID: 8300000, guid: 861765247b9563446b47f7f7992fae8c, type: 3}
  - speaker: Kessler
    text: We can pay.
    seconds: 1.5
    clip: {fileID: 8300000, guid: 9e2c3bd0aecb4a24da113375e60676d5, type: 3}
  - speaker: Broker
    text: Money's not what gets you in. That vault wants trust, and I've got none
      to spend on you.
    seconds: 7
    clip: {fileID: 8300000, guid: cdd3aa8d38a3edd48b94aeea72d54895, type: 3}
  - speaker: Kessler
    text: He's a wall. So we go around him.
    seconds: 3
    clip: {fileID: 8300000, guid: 9cea9b1f7edb0204c8776dbef4ea204e, type: 3}
  - speaker: Ronin-7
    text: Around how.
    seconds: 1.5
    clip: {fileID: 8300000, guid: 9833e5d1a14986349856f52cce930c36, type: 3}
  - speaker: Kessler
    text: Resh already gave us the door. His routes run under this stall. Let's move.
    seconds: 5
    clip: {fileID: 8300000, guid: d0c83caba16591a448d9f362b0790759, type: 3}
  textMesh: {fileID: 1319909199}
  panelRoot: {fileID: 460571097}
  audioSource: {fileID: 390531684}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
