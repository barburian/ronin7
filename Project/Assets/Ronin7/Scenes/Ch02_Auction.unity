  m_Name: Dialogue_Beat3_Iris
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &338384370
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 338384369}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Enforcer
    text: Channel's supposed to be dead down here. Who's moving?
    seconds: 4
    clip: {fileID: 8300000, guid: 90ba9961bcd318e42acedce652cf4294, type: 3}
  - speaker: Resh
    text: The collateral I tracked this morning. Same cage. Your records are still
      past it.
    seconds: 6
    clip: {fileID: 8300000, guid: c8273ac30b5e4b34eba4e157004c5fa6, type: 3}
  - speaker: Iris
    text: If you're buyers, the auction's two tiers up. If you're something else,
      get it over with.
    seconds: 6
    clip: {fileID: 8300000, guid: 7338ca13182dc284bb1e8f85bed354d0, type: 3}
  - speaker: Ronin-7
    text: The tag says Iris.
    seconds: 2.5
    clip: {fileID: 8300000, guid: 78ad2423953ed6845a5678f6277bb61f, type: 3}
  - speaker: Kessler
    text: Say that again. Say the name again.
    seconds: 3
    clip: {fileID: 8300000, guid: 25e4522954d05034b82cd56f5b87669f, type: 3}
  - speaker: Iris
    text: ...Who is that. Who's on the channel.
    seconds: 3
    clip: {fileID: 8300000, guid: 6ebc17f6301661f47973da40612a7c07, type: 3}
  - speaker: Kessler
    text: Iris. It's your father. I've been scraping a dead field for six years to
      buy you back.
    seconds: 10
    clip: {fileID: 8300000, guid: d4912f548071ed545b4b1f74f7710ffd, type: 3}
  - speaker: Iris
    text: They told me you stopped looking. They told me you signed me away.
    seconds: 5
    clip: {fileID: 8300000, guid: 4b9a36eaeaba705459fe98e3dbf2fafd, type: 3}
  - speaker: Kessler
    text: They lied. I never stopped. Not one night. I'm right above you.
    seconds: 7
    clip: {fileID: 8300000, guid: 509f0ce7f3959ed4c92f7f5e7692018c, type: 3}
  - speaker: Ronin-7
    text: Hold still. I'm cutting you loose.
    seconds: 2.5
    clip: {fileID: 8300000, guid: bf44b9fd89f75a948a9e0e92cfc9169d, type: 3}
  - speaker: Iris
    text: You're the one he came with. The operative. He's really up there.
    seconds: 5
    clip: {fileID: 8300000, guid: dc14dca5f96d7984c9ba11ec111644b6, type: 3}
  - speaker: Ronin-7
    text: He never sat down. Go to him.
    seconds: 3
    clip: {fileID: 8300000, guid: 87a49aba445e98549a8d85cf98222c73, type: 3}
  - speaker: Iris
    text: I read systems. Locks, networks, the paper they keep on people. Take me
      to that vault.
    seconds: 7
    clip: {fileID: 8300000, guid: 48d5b43f4cdb08041ad4ce628638d34d, type: 3}
  - speaker: Resh
    text: She's right. I can get you to the door. Getting through it is a different
      trade.
    seconds: 6
    clip: {fileID: 8300000, guid: b2c79f88304414b4c8619ca8d083feda, type: 3}
  - speaker: Kessler
    text: Iris. Stay between them. You come back up to me. You hear?
    seconds: 5
    clip: {fileID: 8300000, guid: 7f5827f3c76e3ab43933f576b8633221, type: 3}
  - speaker: Iris
    text: I hear you. I'm coming back. Let me earn the trip first.
    seconds: 5
    clip: {fileID: 8300000, guid: 86af1f4f33a71244ebb6b203c64ffdfa, type: 3}
  textMesh: {fileID: 585377279}
  panelRoot: {fileID: 780701709}
  audioSource: {fileID: 338384371}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
