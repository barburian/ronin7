  m_Name: Dialogue_Beat5_Reunion
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &148636760
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 148636759}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Iris
    text: It's so quiet up here. I forgot quiet.
    seconds: 3
    clip: {fileID: 8300000, guid: ddd50fc1e9a62064e9c895e0e2dd0cd9, type: 3}
  - speaker: Kessler
    text: Six years I had a voice on a wire and a coffin where you should have been.
      Stand still.
    seconds: 9
    clip: {fileID: 8300000, guid: 48e84573da8301b4790158b970ae9b2f, type: 3}
  - speaker: Kessler
    text: Let me look at you with my own eyes.
    seconds: 3
    clip: {fileID: 8300000, guid: c9dc49267f34de040b729491e522389c, type: 3}
  - speaker: Iris
    text: I told you I'd come back. I earned the trip.
    seconds: 4
    clip: {fileID: 8300000, guid: bc4e20f23d55df04790a40c4858ce4c0, type: 3}
  - speaker: Resh
    text: Hold the moment. I came up that ramp with one more set of footsteps than
      I should have.
    seconds: 6
    clip: {fileID: 8300000, guid: 3e096cdfed30e43438d9afb43cfde8f0, type: 3}
  - speaker: Resh
    text: Stay put.
    seconds: 2
    clip: {fileID: 8300000, guid: bc93a4cb1756d4d49b9f9c75fef4918d, type: 3}
  - speaker: Resh
    text: ...No. No, you don't get to be down here. How did you get past me.
    seconds: 6
    clip: {fileID: 8300000, guid: 25be73011bb36e84b8a2f168a9cc3baa, type: 3}
  - speaker: Mira
    text: You're Resh. You're the one who gets us out.
    seconds: 4
    clip: {fileID: 8300000, guid: 5f6c93e7e6df29b4f80c84d0038c3b8a, type: 3}
  - speaker: Resh
    text: You know my face.
    seconds: 2
    clip: {fileID: 8300000, guid: 4ddfbe41c3d87d049ab704520152fecf, type: 3}
  - speaker: Mira
    text: I saw you on the floor. You weren't running. You were with them. So I followed.
    seconds: 6
    clip: {fileID: 8300000, guid: 4ad0d953ebbf6b54a83cba25720a6019, type: 3}
  textMesh: {fileID: 1754790444}
  panelRoot: {fileID: 1672008091}
  audioSource: {fileID: 148636761}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
