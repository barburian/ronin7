  - component: {fileID: 1432196166}
  - component: {fileID: 1432196165}
  - component: {fileID: 1432196164}
  m_Layer: 0
  m_Name: Dialogue_Beat2_ReshConfront
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &1432196164
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1432196163}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Kessler
    text: That's him. Works the rail like he owns the floor. Easy. We're buyers.
      We talk.
    seconds: 6
    clip: {fileID: 8300000, guid: b4c1144c0e571f646a4f30ff147ca700, type: 3}
  - speaker: Resh
    text: Whatever you're selling, I'm not. Whatever you're buying, not from me.
      I'm working.
    seconds: 6
    clip: {fileID: 8300000, guid: 507e7ab85c09964419d0a7a0d7151e57, type: 3}
  - speaker: Kessler
    text: We need a route. Past a broker who won't open his glass. Word is you know
      the doors off the map.
    seconds: 8
    clip: {fileID: 8300000, guid: c654dc99e1cfaac4bb299a04338c408d, type: 3}
  - speaker: Resh
    text: No. I know what you are. I've moved enough stock to know an operative when
      one's in my light.
    seconds: 8
    clip: {fileID: 8300000, guid: 94a2ef8346a5724419f891067a7bb208, type: 3}
  - speaker: Resh
    text: You're Program work. Men like me don't get found by men like you and walk
      away from it.
    seconds: 7
    clip: {fileID: 8300000, guid: 5fd7b71c25745b9499e18321add186d8, type: 3}
  - speaker: Ronin-7
    text: I'm not here for you.
    seconds: 2
    clip: {fileID: 8300000, guid: 13a890e1e21c3ae4381a535709e04707, type: 3}
  - speaker: Resh
    text: That's exactly what the last one said.
    seconds: 3
    clip: {fileID: 8300000, guid: 09156e379cbca104282819e502172c0c, type: 3}
  - speaker: Resh
    text: I have people on every tier who owe me. I'm worth more to this market alive
      than you are worth getting me.
    seconds: 9
    clip: {fileID: 8300000, guid: e9d422ee7e550c3479b6270a0084c2b5, type: 3}
  - speaker: Resh
    text: So you walk, or this floor decides which of us it keeps.
    seconds: 5
    clip: {fileID: 8300000, guid: 0bde936c8de90aa4fbf84dc1dae8475f, type: 3}
  - speaker: Resh
    text: Go on, then. You've got me. That's how it always ends with your kind.
    seconds: 6
    clip: {fileID: 8300000, guid: 272720d4fb5b1c146a0b65c23f92c0bc, type: 3}
  - speaker: Resh
    text: You find the one door I didn't have. So finish it and stop making me wait.
    seconds: 6
    clip: {fileID: 8300000, guid: e006131455cdb3d4c88303f52fc5ef1b, type: 3}
  - speaker: Ronin-7
    text: Go.
    seconds: 1
    clip: {fileID: 8300000, guid: ba64b1f193330a9449941331a091d78d, type: 3}
  - speaker: Resh
    text: ...What.
    seconds: 1.5
    clip: {fileID: 8300000, guid: f96fd6e67aa66d144bcdec397cf2f7a3, type: 3}
  - speaker: Ronin-7
    text: You're free to go. I won't stop you.
    seconds: 4
    clip: {fileID: 8300000, guid: 377de27426c966f43b480c7614a4795d, type: 3}
  - speaker: Resh
    text: Nobody with their boot on my neck takes it off. Not once, not in my whole
      life down here.
    seconds: 7
    clip: {fileID: 8300000, guid: 11324a439773c8741951ead406a3c996, type: 3}
  - speaker: Resh
    text: Men like you don't spare anybody. You use them up.
    seconds: 4
    clip: {fileID: 8300000, guid: f3b38879cb4106b4fa6074b46a1abe62, type: 3}
  textMesh: {fileID: 1809447796}
  panelRoot: {fileID: 1243131624}
  audioSource: {fileID: 1432196165}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
