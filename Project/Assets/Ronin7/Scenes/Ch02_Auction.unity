--- !u!114 &205308784
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 205308783}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Mira
    text: ...Is the loud part over? Up there. It's loud.
    seconds: 3
    clip: {fileID: 0}
  - speaker: Kessler
    text: ...That's a child. Resh, that is a child standing in my hold.
    seconds: 4
    clip: {fileID: 0}
  - speaker: Resh
    text: She stowed away. Off the auction floor. She's market stock that walked
      off the shelf on her own legs.
    seconds: 7
    clip: {fileID: 0}
  - speaker: Kessler
    text: I'm not in the business of turning a child back toward a cage. Not on this
      ship.
    seconds: 7
    clip: {fileID: 0}
  - speaker: Mira
    text: Are you going to send me back.
    seconds: 3
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: No.
    seconds: 1
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: Nobody puts you back. You stay with the ship. You stay where Kessler can
      see you.
    seconds: 7
    clip: {fileID: 0}
  - speaker: Resh
    text: ...That's twice today you've done a thing your kind doesn't do.
    seconds: 4
    clip: {fileID: 0}
  - speaker: Kessler
    text: Then she stays. She stays aboard, with me, same as Iris. I have the room
      and I have the reason.
    seconds: 7
    clip: {fileID: 0}
  - speaker: Resh
    text: A salvage rat, a freed tech, a stowaway, and me. Hell of a manifest.
    seconds: 5
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: Get some rest. Velorum can keep the rest of it.
    seconds: 3
    clip: {fileID: 0}
  textMesh: {fileID: 960310199}
  panelRoot: {fileID: 836669737}
  audioSource: {fileID: 205308785}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
