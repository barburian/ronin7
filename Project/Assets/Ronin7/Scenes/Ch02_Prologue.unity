  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Kessler
    text: The auction moon. Half the sector's scum bidding on salvage that isn't
      theirs.
    seconds: 4.29
    clip: {fileID: 0}
  - speaker: Kessler
    text: Your sword is down there, Cipher. And somebody paid a lot to make sure
      it never reaches the block.
    seconds: 5.39
    clip: {fileID: 0}
  - speaker: Kessler
    text: Get in, find Mira, get out. I'll keep the Cairn warm.
    seconds: 3
    clip: {fileID: 0}
