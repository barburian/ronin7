--- !u!114 &1155299054
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1155299053}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Resh
    text: Do we take her with us. We don't leave people standing alone in a place
      like this.
    seconds: 6
    clip: {fileID: 8300000, guid: 6a39ee0128e077c49bb82a0b3eb11261, type: 3}
  - speaker: Ronin-7
    text: No. She's not crew. She's got her dead to stay with, and that's hers.
    seconds: 6
    clip: {fileID: 8300000, guid: d1953dedb1065044d9c2a8613aaf75a7, type: 3}
  - speaker: Vera Dusk
    text: He's right. I'm not joining your war. I'm staying with her, and the others
      under this ash, until I know they're remembered by someone who isn't a record.
      But I'll know your name when it's a true one. Come back and tell me, when you've
      dug it up.
    seconds: 16
    clip: {fileID: 8300000, guid: bfbb1366e77da9c40a6adf54a5e0317a, type: 3}
  textMesh: {fileID: 925395271}
  panelRoot: {fileID: 799327758}
  audioSource: {fileID: 1155299055}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
