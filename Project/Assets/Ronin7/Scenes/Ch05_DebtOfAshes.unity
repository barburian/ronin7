  m_Name: Dialogue_Beat4_Verdict
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &178157098
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 178157097}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Vera Dusk
    text: They built a hand that doesn't feel. And it felt something in my square.
      No wonder they were afraid of you. And killing it won't raise her.
    seconds: 12
    clip: {fileID: 8300000, guid: f657a1bab2e7a014eaf2bee586687ea8, type: 3}
  - speaker: Vera Dusk
    text: Dying's easy. You'd be gone in a second and I'd still be standing here.
      So you don't get easy. You stay alive, and every day you do, you owe her. You
      won't ever be done.
    seconds: 15
    clip: {fileID: 8300000, guid: ab7509b789e9e804dbe6c567e9591573, type: 3}
  - speaker: Ronin-7
    text: I'll carry it. I won't pretend I can earn it down to nothing, because I
      can't. But I'll carry her name as long as I've got a hand to carry it. That
      much I can actually promise.
    seconds: 12
    clip: {fileID: 8300000, guid: 4acb01009a6e01e47b9cc9657ec92666, type: 3}
  - speaker: Mera Voss
    text: Twice now. Kerrax in the caves, this one over a grave. I spent nine years
      certain the metal couldn't choose twice. I don't know what I'm sure of anymore.
    seconds: 11
    clip: {fileID: 8300000, guid: 3e84f527f5aa86b458b6ce4fd624d794, type: 3}
  textMesh: {fileID: 1095225498}
  panelRoot: {fileID: 902950176}
  audioSource: {fileID: 178157099}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
