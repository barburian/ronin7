--- !u!114 &1107169375
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1107169374}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Ronin-7
    text: If the name they hung on me was a lie, then everything behind it is too.
      The grave, the file, the man I thought I half-remembered. None of it real.
    seconds: 9
    clip: {fileID: 8300000, guid: 6f8229195d9737348a6d2bbcdbfe37e2, type: 3}
  - speaker: Echo
    text: Forget who they told you you were. We find who's under it. I've got nothing
      but time, Cipher, and I was there for the start of it. We'll find the rest.
    seconds: 12
    clip: {fileID: 8300000, guid: 123e5b3f7b2910c4ea223560ffc64223, type: 3}
  textMesh: {fileID: 1038401027}
  panelRoot: {fileID: 1449763261}
  audioSource: {fileID: 1107169376}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
