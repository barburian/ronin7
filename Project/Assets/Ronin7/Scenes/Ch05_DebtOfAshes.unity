  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Echo
    text: She's not a scavenger, not a picker. She's been standing at that grave
      since before we landed. Careful, Cipher. This isn't a fight. It's worse than
      one.
    seconds: 10
    clip: {fileID: 8300000, guid: 9f6f753dd35c22542a1b257c4fe6d922, type: 3}
  - speaker: Echo
    text: Doors all open. Nobody left to close them.
    seconds: 3
    clip: {fileID: 8300000, guid: cb4b7c737886087488d5173fa25a1707, type: 3}
