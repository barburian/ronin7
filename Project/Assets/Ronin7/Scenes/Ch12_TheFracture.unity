--- !u!114 &1690898262
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1690898261}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Vale
    text: Don't stop on my account. You've walked a long way down to me. Further
      than you know. Most men who reach this room reach it cold, on a slab, asleep.
      You reached it on your feet. That alone tells me the reports were right about
      you. I am Vale. They put me in the cold a long time ago and told me I'd be
      woken when the line finally produced something worth commanding. I confess
      I'd stopped believing it. And then the network woke me, and I opened my eyes,
      and here you are, standing in the middle of the answer with a sword in your
      hand and no idea what you're standing in.
    seconds: 25
    clip: {fileID: 8300000, guid: bab6ac2930b952243b2789f22e9f8326, type: 3}
  - speaker: Ronin-7
    text: I know exactly what I'm standing in. I counted it on the way down. Say
      what you want and don't dress it.
    seconds: 7
    clip: {fileID: 8300000, guid: eeca09f82b4333747a7352b0acb63742, type: 3}
  textMesh: {fileID: 1116696312}
  panelRoot: {fileID: 1825855089}
  audioSource: {fileID: 1690898263}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
