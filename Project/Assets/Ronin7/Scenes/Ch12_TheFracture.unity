MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1718951366}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Ronin-7
    text: You keep calling it the most good I'll ever do. You'd know. You've spent
      a long time in the cold rehearsing the most good a cage can do. Here's the
      answer, Vale, and it's the only one I've got. An army of the freed, commanded,
      is just the cage with a kinder face on the door. I've cut that door open too
      many times to walk back through it holding the key. You're right that someone
      worse might pick this up. So I'm not going to leave it for them. I'm not going
      to hand it to you. And I'm not going to keep it. I'm going to break it.
    seconds: 20
    clip: {fileID: 8300000, guid: 9605ba580807c2a4caa2f264e607dae0, type: 3}
  textMesh: {fileID: 2104476877}
  panelRoot: {fileID: 989199914}
  audioSource: {fileID: 1718951368}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
