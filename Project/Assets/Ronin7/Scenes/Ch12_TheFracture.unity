  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Echo
    text: The record's whole now, Cipher. And it doesn't just say how they built
      the leash. It says who. One name under all of it, one hand that drew you and
      the killswitch and every cradle in this room. We don't go down anymore. We
      go to him. The man who made you. That's the last door, and it's the only one
      left.
    seconds: 14
    clip: {fileID: 8300000, guid: 144cde5abc6bc11488bfcb2de5b24789, type: 3}
