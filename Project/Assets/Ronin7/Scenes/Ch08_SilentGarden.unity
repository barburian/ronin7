  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: The Woman
    text: There. That's the last of it.
    seconds: 3
    clip: {fileID: 0}
  - speaker: The Woman
    text: I hope you will save us.
    seconds: 3
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: Turn. Let me see your face.
    seconds: 3
    clip: {fileID: 0}
