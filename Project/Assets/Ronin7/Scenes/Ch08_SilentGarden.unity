  m_Name: Dialogue_Beat5_Reunion
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &475304021
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 475304020}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Kessler
    text: There he is. We held the gate, every hour of it, and that thing never let
      us a step closer. You walk out of there in one piece?
    seconds: 10
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: In one piece. It tested the head and the hands, Echo, not the blade. The
      blade only mattered at the very end.
    seconds: 8
    clip: {fileID: 0}
  - speaker: Coral Vex
    text: It opened for you, and it let you walk back out, which is more than the
      legend ever promised anyone. Did it give you the truth, Cipher? Did you see
      the hand?
    seconds: 11
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: I saw the hand that made the switch. A woman. Careful. She said she hoped
      I'd save us, and I couldn't see her face. I saw the hand that pulled it too.
      He grieved it. And he's started to doubt the order that made him.
    seconds: 14
    clip: {fileID: 0}
  - speaker: Mera Voss
    text: A maker who hoped you'd live. A handler who doubts the order he carried
      out. I hunted for the Program for years and I'd have sworn it didn't have a
      doubting bone in it. Turns out it's riddled with them.
    seconds: 12
    clip: {fileID: 0}
  - speaker: Mira
    text: You're sad. You found out something good, didn't you. So why do you look
      like that.
    seconds: 5
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: I found out two people on the inside didn't want me dead, little one. One
      of them hoped I'd live before I was old enough to remember her. That's a good
      thing. It's just heavy.
    seconds: 11
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: The Garden says the answers aren't up here, not with the rest of us still
      breathing and shouting. So we stop hunting the surface. We go down.
    seconds: 10
    clip: {fileID: 0}
  - speaker: Echo
    text: Down the dark next, Cipher. We came to a graveyard to ask the dead who
      made us, and they handed us two living questions and a road under the floor.
      The pits. The deeps. Wherever they buried it, we go dig it out.
    seconds: 12
    clip: {fileID: 0}
  textMesh: {fileID: 1781717915}
  panelRoot: {fileID: 2046516062}
  audioSource: {fileID: 475304022}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
