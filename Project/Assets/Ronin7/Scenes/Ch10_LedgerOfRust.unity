  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &577705749
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 577705748}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Echo
    text: We're in, Cipher. First tier. It's a mine, an honest one, or it was. Dead
      lift-cages, carts gone to rust, ore-seams picked clean a long time ago. The
      syndicate squatters up here think they're sitting on a played-out hole they
      can charge tolls through. Keep dropping. Gryph says it stays a mine for a while
      yet. I'll tell you the second it stops being one.
    seconds: 16
    clip: {fileID: 8300000, guid: d19cd6b6140d3274f9276b2bfe55f525, type: 3}
  - speaker: Gryph
    text: This is good rock, Cipher. I mean it. Honest dig, the kind men did because
      there was ore in it. Follow the old cuts and they'll hold. It's when the cuts
      stop and the smooth starts that you slow down and you trust nothing. A mine
      that's still a mine wants to give up its ore. A mine that's turned into something
      else wants to keep you out, and it'll drop a tier on your head to do it. We're
      not there yet. Drop the next two cages and watch the shoring.
    seconds: 21
    clip: {fileID: 8300000, guid: 7678bb8951732224287c083137bc4d0f, type: 3}
  textMesh: {fileID: 1061559324}
  panelRoot: {fileID: 739790862}
  audioSource: {fileID: 577705750}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
