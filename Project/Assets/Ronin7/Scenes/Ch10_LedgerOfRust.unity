  m_IsActive: 1
--- !u!114 &468101114
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 468101113}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Ronin-7
    text: Before the names. The one I just put down. He called himself Ninja-2, and
      you say his whole make is seated in you. Tell me what the Ninja program was.
      I want to know what I killed, and what you're carrying.
    seconds: 11
    clip: {fileID: 8300000, guid: e82c40c9f66bb7640bed666751821fb7, type: 3}
  - speaker: Cassie-04
    text: The Ninja program. Two builds before your Ronin line, Cipher, the Dominion's
      first real attempt at a blade nobody could trace. They made your make to be
      seen, to be the thing worlds surrendered to before you ever drew. They made
      the Ninja for the opposite job. Single operatives slipped in quiet, one cut,
      gone before anybody knew a war had walked through the room. No banner, no serial
      that ever lived to be reported. And they were good. That was the problem. A
      weapon you can't see is a weapon you can't be sure you still own. The Dominion
      got more afraid of its own ghosts than of anything it pointed them at, so it
      did what it always does with a thing it can't control. It erased the make.
      Every Ninja they ever ran, struck off the books and racked, here, in me. Sever
      was the last one still on his feet, and they didn't even let him be a man at
      the end. They turned their last invisible blade into a locked door and set
      him to guard the grave of everyone he came from. That's the Ninja program.
      You just gave the last of them the only rest the Dominion ever left on the
      shelf.
    seconds: 32
    clip: {fileID: 8300000, guid: 524ed3ec16a482d47931f6307ecea641, type: 3}
  textMesh: {fileID: 2000374213}
  panelRoot: {fileID: 1426905508}
  audioSource: {fileID: 468101115}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
