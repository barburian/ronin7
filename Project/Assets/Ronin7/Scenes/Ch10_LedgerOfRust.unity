  m_IsActive: 1
--- !u!114 &1012084221
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1012084220}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Vess
    text: Don't move. Don't you dare move that blade. Eleven years I crossed the
      chart for this exact half-second, and I mean to have it clean. You don't know
      my face. Why would you. But I've known yours since I was a child pulling my
      family out of the rubble your line left behind. So look at me. Understand it's
      a person doing this. Give me one reason. You took everyone I had.
    seconds: 15
    clip: {fileID: 8300000, guid: 6830c83fb9c77e94292a0e4b5813895b, type: 3}
  - speaker: Ronin-7
    text: I won't give you one. You're right. My line came down on your world and
      I was the kind of thing they pointed at worlds. If you've got the truth of
      it, then you've got the right to it. Kill me. It's fair.
    seconds: 11
    clip: {fileID: 8300000, guid: db7cf9a161877fb4cbf0fb47a97e21e8, type: 3}
  - speaker: Ronin-7
    text: But know what dies with me before you do it. The names of everyone they
      took are in her, the archive we just carried up out of the dark. Every one
      of them. The true names, the children, your people, filed where no one was
      ever meant to read them. I'm the one who can read them out loud to the galaxy.
      Open my throat and the count stays buried, and the shadows still on the racks
      stay on the racks. Your revenge is real. It's just very, very small next to
      what we could do with my life instead of my death.
    seconds: 21
    clip: {fileID: 8300000, guid: d86e5bbe387163e41b4e430f9be263db, type: 3}
  textMesh: {fileID: 478944274}
  panelRoot: {fileID: 1199813264}
  audioSource: {fileID: 1012084222}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
