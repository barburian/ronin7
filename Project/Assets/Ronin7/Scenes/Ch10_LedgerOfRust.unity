  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 917682234}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Echo
    text: Feel that. You just stepped through a wall like it owed you the right of
      way. That's his gift, Cipher, the one thing they ever let him do that wasn't
      standing still in front of a cage. Phase-step. A short blink, through matter,
      through bodies, through anything between you and where you need to be. They
      built him to be the wall nobody got past. So his last act is to make you the
      man no wall can hold. Use it gently. It's the only soft thing he had to give.
    seconds: 21
    clip: {fileID: 8300000, guid: 763085009d18c1b4b816fcdcdd72fb35, type: 3}
  textMesh: {fileID: 1222758290}
  panelRoot: {fileID: 349105638}
  audioSource: {fileID: 917682236}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
