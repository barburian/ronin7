  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Kerrax
    text: The recovery walks in on its own legs. Saves me the finder's fee. You've
      cost me four good enforcers and a courier I had three-quarters sold, operative.
    seconds: 11
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: You're selling a man you've never met to a man you've never met. Both of
      them want me for reasons you don't know. That should worry you more than it
      does.
    seconds: 11
    clip: {fileID: 0}
  - speaker: Kerrax
    text: Reasons are for buyers. I just collect.
    seconds: 4
    clip: {fileID: 0}
  textMesh: {fileID: 628316939}
  panelRoot: {fileID: 874985473}
  audioSource: {fileID: 251832457}
  billboardToCamera: 1
  playOnStart: 0
