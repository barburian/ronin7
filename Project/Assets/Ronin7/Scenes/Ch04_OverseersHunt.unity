  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Echo
    text: Footing's loose on the left. Stay to the rock.
    seconds: 3
    clip: {fileID: 0}
  - speaker: Echo
    text: Drone, your three. Hold there till it passes.
    seconds: 3
    clip: {fileID: 0}
  - speaker: Echo
    text: Water's rising ahead. Shallow yet. Keep moving.
    seconds: 3
    clip: {fileID: 0}
  - speaker: Echo
    text: Crowd's long gone. Just us and the dark now.
    seconds: 3
    clip: {fileID: 0}
