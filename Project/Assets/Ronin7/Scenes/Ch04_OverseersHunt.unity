--- !u!114 &273432260
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 273432259}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Khall
    text: Cipher. You are listed terminated. You are making that a difficult fiction
      to maintain.
    seconds: 6
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: That's not my name.
    seconds: 2
    clip: {fileID: 0}
  - speaker: Khall
    text: It is the one I gave you.
    seconds: 3
    clip: {fileID: 0}
  - speaker: Khall
    text: I am your Overseer. My name is Khall. I am not trying to kill you, Cipher.
      I am trying to bring you home before someone with less patience than I have
      finds you first.
    seconds: 13
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: Home doesn't put a switch in your skull.
    seconds: 4
    clip: {fileID: 0}
  - speaker: Khall
    text: No. It doesn't.
    seconds: 3
    clip: {fileID: 0}
  - speaker: Echo
    text: That's him. That's the voice from the bay, the one that pulled your switch
      and couldn't watch you fall. He's older now.
    seconds: 8
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: You couldn't look at me when you did it. I watched you. So tell me what
      home is, that you'd switch me off for refusing an order, and then chase me
      across a free-port to switch me back on.
    seconds: 14
    clip: {fileID: 0}
  - speaker: Khall
    text: You were not meant to remember the bay. We will discuss what you're owed
      when you're home, and not before. The bounty stands. For your sake, end this
      and let me bring you in.
    seconds: 14
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: The man at the bottom of these caves is selling me to you. I'm going to
      go and ask him why he thinks I'm his to sell.
    seconds: 9
    clip: {fileID: 0}
  textMesh: {fileID: 1797902408}
  panelRoot: {fileID: 1975479440}
  audioSource: {fileID: 273432261}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
