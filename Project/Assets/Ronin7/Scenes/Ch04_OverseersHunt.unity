--- !u!114 &522341675
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 522341674}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Iris
    text: Cipher. That's what it kept calling you. And the handler, Khall.
    seconds: 5
    clip: {fileID: 0}
  - speaker: Resh
    text: Cipher. Suits you better than nothing did. Easier to shout across a fight,
      anyway.
    seconds: 5
    clip: {fileID: 0}
  - speaker: Kessler
    text: That's no manhunt. He's trying to take something back, and grief like that
      gets people killed. I don't trust it.
    seconds: 11
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: Cipher.
    seconds: 1
    clip: {fileID: 0}
  - speaker: Echo
    text: They named you to own you. Doesn't mean it's theirs. Come on. Khall's bought
      a man, and that man's at the bottom of this rock.
    seconds: 10
    clip: {fileID: 0}
  textMesh: {fileID: 1843296987}
  panelRoot: {fileID: 92709810}
  audioSource: {fileID: 522341676}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
