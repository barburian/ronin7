--- !u!114 &1944524444
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1944524443}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Echo
    text: This is the part they built into your hands. The order says finish it.
      You don't have to listen to your hands, Cipher. Not anymore.
    seconds: 9
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: Tell them what you saw.
    seconds: 2
    clip: {fileID: 0}
  - speaker: Kerrax
    text: They'll say you malfunctioned. A killer that stops is a broken killer.
    seconds: 5
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: Then I'll keep malfunctioning.
    seconds: 3
    clip: {fileID: 0}
  - speaker: Mera Voss
    text: A machine doesn't choose twice.
    seconds: 3
    clip: {fileID: 0}
  - speaker: Echo
    text: The rail. The one who already knew your face.
    seconds: 4
    clip: {fileID: 0}
  - speaker: Mera Voss
    text: I'm Mera Voss. I tracked operatives for the Dominion. They sent me to confirm
      a kill, yours or his, didn't matter which. Not one ever stopped.
    seconds: 10
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: And now one stopped.
    seconds: 2
    clip: {fileID: 0}
  - speaker: Mera Voss
    text: Metal doesn't hesitate like that. You did.
    seconds: 3
    clip: {fileID: 0}
  textMesh: {fileID: 855922752}
  panelRoot: {fileID: 140456369}
  audioSource: {fileID: 1944524445}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
