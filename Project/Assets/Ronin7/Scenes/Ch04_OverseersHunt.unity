--- !u!114 &528437723
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 528437722}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Tessa Rin
    text: Whatever you're buying, I'm sold out and I'm leaving. Try the next stall.
    seconds: 5
    clip: {fileID: 0}
  - speaker: Resh
    text: We're not Coil. You're Tessa Rin, you're carrying Program internals, and
      there's a snatch-team two aisles back moving like they already bought you.
      We can get you out.
    seconds: 11
    clip: {fileID: 0}
  - speaker: Tessa Rin
    text: Everybody says they can get me out. Then I'm in a Coil cell counting my
      own teeth.
    seconds: 6
    clip: {fileID: 0}
  - speaker: Tessa Rin
    text: That's the face on the bounty. You're the recovery. You're the thing the
      whole port's hunting tonight.
    seconds: 7
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: Then for the next few minutes the Coil wants me more than they want you.
      Walk behind me. Decide now.
    seconds: 8
    clip: {fileID: 0}
  - speaker: Echo
    text: That's the team. Four. The second they read your face that bounty triples
      and you're the prize.
    seconds: 8
    clip: {fileID: 0}
  - speaker: Kessler
    text: Iris, get her and the slate behind the plate-stacks. Resh, with me.
    seconds: 5
    clip: {fileID: 0}
  textMesh: {fileID: 190729438}
  panelRoot: {fileID: 1725707764}
  audioSource: {fileID: 528437724}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
