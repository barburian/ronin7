--- !u!114 &305730563
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 305730562}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Echo
    text: That's your face on his slate. And on the drone. Whole city's been handed
      your picture. Welcome to Drovis.
    seconds: 8
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: Then we keep moving and we don't look up.
    seconds: 3
    clip: {fileID: 0}
  - speaker: Resh
    text: Drone overhead, two scanners on the rail. Coil's got the chokes plugged
      and they're checking faces, not papers.
    seconds: 9
    clip: {fileID: 0}
  - speaker: Resh
    text: Coil doesn't pay for a customs sweep. Somebody's funding this.
    seconds: 4
    clip: {fileID: 0}
  - speaker: Echo
    text: Rail. High left. The one not buying anything.
    seconds: 3
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: Saw it.
    seconds: 1
    clip: {fileID: 0}
  - speaker: Echo
    text: That one wasn't reading a slate. That one already knew your face before
      the bounty. Different kind of trouble.
    seconds: 8
    clip: {fileID: 0}
  - speaker: Kessler
    text: Enforcer?
    seconds: 1
    clip: {fileID: 0}
  - speaker: Ronin-7
    text: No. Enforcers stand where the bounty tells them. That one chose the rail.
      Leave it. We have a courier to reach.
    seconds: 9
    clip: {fileID: 0}
  textMesh: {fileID: 1701164811}
  panelRoot: {fileID: 480516307}
  audioSource: {fileID: 305730564}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
