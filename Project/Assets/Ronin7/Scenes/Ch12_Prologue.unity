  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: Kessler
    text: "Cold deck. Frost makes every rail a promise it won't keep \u2014 Gryph's
      words, not mine."
    seconds: 4.62
    clip: {fileID: 8300000, guid: 93c8f0e9efa9d1141bffb94d767f5e91, type: 3}
  - speaker: Kessler
    text: The record's whole down there. It says who drew the leash. Go read the
      name.
    seconds: 4.18
