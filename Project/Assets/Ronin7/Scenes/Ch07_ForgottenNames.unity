  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: The Previous Owner
    text: Another one. They keep sending you, and I keep putting you down, and the
      dark always comes back. You're not taking my blade.
    seconds: 8
    clip: {fileID: 8300000, guid: aef10502b2fe1d84eba0d8031319c312, type: 3}
  - speaker: Echo
    text: Stay with me, Cipher. Don't owe that memory anything. It's just the wall
      keeping the blade asleep. Take it down.
    seconds: 8
    clip: {fileID: 8300000, guid: 995e49376ecd0ed4d969d33fb3e391f4, type: 3}
