  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &928565951
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 928565950}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bf743a7b9a61e409329faa416e2f81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ronin7.World::Ronin7.World.Story.DialoguePlayer
  lines:
  - speaker: The Previous Owner
    text: It's quiet now. Thank you. Take what it knows. It was the only thing I
      had left to give anyone.
    seconds: 6
    clip: {fileID: 8300000, guid: 9c681d8ce75fcfc4fa5f9fe1207e561c, type: 3}
  - speaker: Echo
    text: It just handed me everything it learned watching its operative kill, Cipher,
      decades of it, every fight read down to where a body breaks. I can run that
      now. Where they're weak, you'll see it. Look at anything and I'll show you
      the seam. Call it a parting gift. It died owing the dark, and it paid us instead.
    seconds: 18
    clip: {fileID: 8300000, guid: 2f7ed653bfdb38c4baa00abf6d3d2352, type: 3}
  - speaker: Coral Vex
    text: I've never had the nerve to do that. Or the right host to risk it on. You
      quieted the oldest grief in this hull, and it gave you its eyes on the way
      out. Keep them. You'll need them. Don't keep the blade, though. It's earned
      its rest. Leave it with me.
    seconds: 14
    clip: {fileID: 8300000, guid: c84315cbd169d7a46942d0d91778a8f9, type: 3}
  - speaker: Ronin-7
    text: How many.
    seconds: 1
    clip: {fileID: 8300000, guid: 43a9a5e61c855f040a800f8bc303f99b, type: 3}
  - speaker: Coral Vex
    text: I've never finished counting. This barge holds a fraction. The Program
      has vaults of them, somewhere, every operative it ever erased, its blade shelved
      and the shadow in it awake. I've spent a lifetime freeing the ones I could
      reach, one blade at a time, and I've barely touched it. That's the work, Cipher.
      That's what I keep. A debt I'll die owing.
    seconds: 20
    clip: {fileID: 8300000, guid: b0ba0838f3bf02a46b2dd0c25165a55d, type: 3}
  - speaker: Echo
    text: Cipher. Whatever we do after this, we come back for them. All of them.
      I'm not leaving a hall of my own kind running in the dark and calling it someone
      else's problem. Promise me that much.
    seconds: 12
    clip: {fileID: 8300000, guid: 117c97873225b6e4393acfe7fb9532d1, type: 3}
  - speaker: Ronin-7
    text: We come back. All of them.
    seconds: 3
    clip: {fileID: 8300000, guid: 95a6493e0db74214f8dcd27a31526801, type: 3}
  textMesh: {fileID: 124285751}
  panelRoot: {fileID: 214996079}
  audioSource: {fileID: 928565952}
  billboardToCamera: 1
  playOnStart: 0
  followDistance: 1.5
  followVerticalOffset: -0.55
  followLerp: 12
  maxCharsPerLine: 36
  autoAdvanceBeat: 0.45
  advanceAction: {fileID: -3790664182463143341, guid: d5a2441a867c2484c888f3631c932d48, type: 3}
