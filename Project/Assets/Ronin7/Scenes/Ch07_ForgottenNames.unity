  - component: {fileID: 1420055017}
  - component: {fileID: 1420055016}
  - component: {fileID: 1420055015}
  m_Layer: 0
  m_Name: Dialogue_Beat2_Archivist
  m_TagString: Untagged
  m_Icon: {fileID: 0}
