  lines:
  - speaker: Echo
    text: Let the machine and the looters bleed each other. Then walk through.
    seconds: 5
    clip: {fileID: 8300000, guid: e7e8c773c9f81dd46ad1515d7d4777a0, type: 3}
  - speaker: Echo
    text: Scavenger's running. Let him. He's not the job.
    seconds: 4
